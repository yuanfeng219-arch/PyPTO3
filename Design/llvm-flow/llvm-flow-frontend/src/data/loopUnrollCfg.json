    "dev": "int sum_positive(const int* a, int n) {\n  int total = 0;\n  for (int i = 0; i < n; ++i) {\n    int x = a[i];\n    if (x > 0) {\n      total += x;\n    }\n  }\n  return total;\n}",
    "host": "int sum_positive(const int* a, int n) {\n  int total = 0;\n  for (int i = 0; i + 1 < n; i += 2) {\n    int x1 = a[i];\n    if (x1 > 0) total += x1;\n    int x2 = a[i + 1];\n    if (x2 > 0) total += x2;\n  }\n  return total;\n}",
