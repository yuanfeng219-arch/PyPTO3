      },
      {
        "id": "u55",
        "parent": "root",
        "stage": "frontend",
        "catalog_id": "F-23",
        "delta": "INTERLEAVE N iterations of an outer pypto.loop into an inner one, so N independent chains run concurrently instead of one after another. Replicate every loop-carried accumulator N times, fold the outer axis in with `for j in range(N)` and index it as `outer*N + j`, and divide the outer loop's trip count by N. Raises the number of independent work items without changing the total work, which is the lever when the profile says the pipes are idle and waiting on each other rather than saturated. Measured 8390 -> 4580 us on flash_attention_mha. THIS MUST BE A SOURCE REWRITE. The directive that would express it, F-8's unroll_list, cannot reach an outer loop: OL49 confines it to the innermost pypto.loop because an outer unroll_list causes exponential compile-path growth AND a register-copy pass defect that corrupts precision (pypto-precision-debug #223, #341). Do not attempt to relax that rule. THE TRAP, and it is silent: raising N WITHOUT replicating the accumulators leaves N independent chains sharing one running state. The kernel still compiles and still runs. Replicate first, then raise N. N must divide the outer trip count. Often pairs with F-5, because the inner loop has to become a Python `for` before the bodies can be interleaved at all.",
        "V": 0.6,
        "prior_gain": 0.6,
        "tried": 0,
        "requires": [
          "has_nested_pypto_loop"
        ]
      }
    ]
