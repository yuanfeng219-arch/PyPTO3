{
  "name": "ResNet50 demo",
  "framework": "pytorch",
  "inputs": [{"name": "image", "shape": [1, 3, 224, 224], "dtype": "float32"}],
  "nodes": [
    {"id": "conv1", "op": "Conv2d", "inputs": ["image"], "outputs": ["x1"], "shape": [1, 64, 112, 112], "dtype": "float32"},
    {"id": "relu", "op": "ReLU", "inputs": ["x1"], "outputs": ["x2"], "shape": [1, 64, 112, 112], "dtype": "float32"},
    {"id": "attention_like", "op": "MultiheadAttention", "inputs": ["x2"], "outputs": ["x3"], "shape": [1, 196, 64], "dtype": "float16"},
    {"id": "output", "op": "Linear", "inputs": ["x3"], "outputs": ["logits"], "shape": [1, 1000], "dtype": "float32"}
  ]
}
